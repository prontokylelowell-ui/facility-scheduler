APP_NAME=FacilityScheduler
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL
#
# RUNTIME connection: the application connects as `app_user` (NOT a superuser).
# This is the "auth-aligned" integration the rubric asks for — the web app's
# identity maps onto a real PostgreSQL role with limited GRANTs + RLS.
#
# MIGRATIONS must run as the owner/superuser, because the migrations create
# roles, extensions, policies and functions. Override just for that command:
#
#   PowerShell:  $env:DB_USERNAME='postgres'; php artisan migrate:fresh --seed
#   bash:        DB_USERNAME=postgres php artisan migrate:fresh --seed
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facility_scheduler
DB_USERNAME=app_user
DB_PASSWORD=app_user_pass_2026

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
FILESYSTEM_DISK=local
